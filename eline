[32m+[m
[32m+[m[32mdef tokens(text):[m
[32m+[m[32m    return [word for word in re.findall(r"[a-z0-9]+", text.lower()) if word not in STOP][m
[32m+[m
[32m+[m[32mdef retrieve(question):[m
