[32m+[m[32m        "question": question,[m
[32m+[m[32m        "status": "review_required" if sufficient else "insufficient_evidence",[m
[32m+[m[32m        "candidate_excerpt": evidence[0]["excerpt"] if sufficient else None,[m
[32m+[m[32m        "evidence": evidence,[m
[32m+[m[32m        "mode": "deterministic_lexical_baseline",[m
[32m+[m[32m        "warning": "Matching text is not proof that a question is answered. A human must review it. No AI answer was generated.",[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32mdef evaluate():[m
[32m+[m[32m    rows = [][m
[32m+[m[32m    for case in CASES:[m
[32m+[m[32m        result = review(case["question"])[m
[32m+[m[32m        actual = result["evidence"][0]["document_id"] if result["candidate_excerpt"] else None[m
