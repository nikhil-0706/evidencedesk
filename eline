[32m+[m[32m    for doc in DOCUMENTS:[m
[32m+[m[32m        for sentence in re.split(r"(?<=[.!?])\s+", doc["text"]):[m
[32m+[m[32m            words = Counter(tokens(sentence))[m
[32m+[m[32m            matches = query.intersection(words)[m
[32m+[m[32m            score = len(matches) / max(len(query), 1)[m
[32m+[m[32m            if matches:[m
[32m+[m[32m                ranked.append({"document_id": doc["id"], "title": doc["title"],[m
[32m+[m[32m                               "version": doc["version"], "excerpt": sentence,[m
